# Byte-compiled files. These were tracked, which is how a copy of the FIRMS key
# ended up inside config.cpython-314.pyc as well as in the source.
__pycache__/
*.py[cod]

.DS_Store

# Never commit a credential. Keys belong in the environment or the Keychain.
.env
*.key

# Generated per-machine by `firewatch-ctl install` — contains local paths.
com.firewatch.zavidovici.plist

# Rebuilt from the database every cycle; Pages serves it from the workflow artifact.
public/
state/fire-map*.js
state/fire-map*.html
state/snapshot.json
state/firewatch.log
